{
  "skill_id": "idapython",
  "name": "idapython",
  "version": "example-0.1.0",
  "description": "IDA Pro Python scripting for reverse engineering, decompilation, xrefs, functions, names, bytes, and ida_* APIs.",
  "aliases": ["@idapython", "idapython", "IDA", "IDAPython", "Hex-Rays"],
  "entrypoint": "SKILL.md",
  "index": "INDEX.md",
  "activation": {
    "trigger_terms": [
      "ida_*",
      "idautils",
      "ida_hexrays",
      "decompile",
      "xrefs",
      "tinfo_t",
      "segments",
      "functions",
      "Hex-Rays"
    ]
  },
  "docs": [
    {"path": "docs/idautils.md", "title": "idautils", "tags": ["iteration", "functions", "xrefs", "strings"]},
    {"path": "docs/ida_hexrays.md", "title": "ida_hexrays", "tags": ["decompiler", "ctree", "pseudocode"]}
  ],
  "recommended_tools": [
    "list_ida_instances",
    "get_ida_database_info",
    "list_functions",
    "decompile_function",
    "get_xrefs",
    "execute_idapython"
  ],
  "retrieval": {
    "default_max_docs": 6,
    "default_max_chars": 12000,
    "prefer_summary_docs": true,
    "full_reference_globs": ["docs/*.rst"]
  },
  "policy": {
    "prefer_structured_reads_first": true,
    "mutations_require_confirmation": true,
    "dry_run_first": true,
    "can_validate": true,
    "suggested_checks": [
      "Call ida_auto.auto_wait() before reading analysis results.",
      "Prefer structured read-only tools before execute_idapython.",
      "For mutations, preview a dry-run ChangeSet before applying."
    ],
    "failure_behavior": [
      "If Hex-Rays is unavailable, fall back to disassembly and xrefs.",
      "If a symbol is missing, search names/imports before hardcoding addresses."
    ]
  }
}
